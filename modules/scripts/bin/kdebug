#!/usr/bin/env bash
#
# kdebug - spin up an ephemeral netshoot pod for network debugging
#
# Usage:
#   kdebug.sh                                    # shell, default namespace
#   kdebug.sh -n cattle-system                   # shell in a namespace
#   kdebug.sh curl -vk https://host/ping          # run a one-off command
#   kdebug.sh --node worker-3 curl -vk https://host/ping
#   kdebug.sh -n cattle-system --node worker-3 bash
#
# Install:
#   chmod +x kdebug.sh
#   sudo mv kdebug.sh /usr/local/bin/kdebug

set -euo pipefail

NS=""
NODE=""
IMAGE="nicolaka/netshoot:v0.16"
POD_NAME="netshoot-$$"
ARGS=()

usage() {
  cat <<EOF
Usage: $(basename "$0") [-n|--namespace NS] [--node NODE] [--image IMAGE] [-- CMD...]

  -n, --namespace NS   Namespace to run the pod in
      --node NODE      Pin the pod to a specific node (nodeName, no toleration added)
      --image IMAGE    Override the debug image (default: nicolaka/netshoot)
  -h, --help           Show this help

If no command is given, drops into an interactive bash shell in the pod.

Note: the pod is run under the 'restricted' Pod Security Standard
(non-root, no privilege escalation, all capabilities dropped, seccomp
RuntimeDefault). Tools that need raw sockets or NET_ADMIN (tcpdump,
ping in some configurations) may not work unless your namespace's
PodSecurity level permits more, or you add specific capabilities back.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--namespace) NS="$2"; shift 2 ;;
    --node)         NODE="$2"; shift 2 ;;
    --image)        IMAGE="$2"; shift 2 ;;
    -h|--help)      usage; exit 0 ;;
    --)             shift; ARGS+=("$@"); break ;;
    *)              ARGS+=("$1"); shift ;;
  esac
done

# Build the nodeName fragment (empty if --node wasn't given)
NODE_NAME_JSON=""
if [[ -n "$NODE" ]]; then
  NODE_NAME_JSON="\"nodeName\": \"${NODE}\","
fi

# kubectl run names the generated container the same as the pod, so this
# container securityContext strategically merges onto it by name.
OVERRIDES=$(cat <<JSON
{
  "apiVersion": "v1",
  "spec": {
    ${NODE_NAME_JSON}
    "securityContext": {
      "runAsNonRoot": true,
      "runAsUser": 65534,
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "containers": [
      {
        "name": "${POD_NAME}",
        "image": "${IMAGE}",
        "stdin": true,
        "tty": true,
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": ["ALL"]
          }
        }
      }
    ]
  }
}
JSON
)

KUBECTL_ARGS=(run "$POD_NAME" --rm -it --restart=Never --image="$IMAGE" --overrides="$OVERRIDES")

[[ -n "$NS" ]] && KUBECTL_ARGS+=(-n "$NS")

if [[ ${#ARGS[@]} -eq 0 ]]; then
  exec kubectl "${KUBECTL_ARGS[@]}" -- bash
else
  exec kubectl "${KUBECTL_ARGS[@]}" -- "${ARGS[@]}"
fi
